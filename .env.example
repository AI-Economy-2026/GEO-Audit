# Copy to .env and fill in real values. Never commit real secrets.

# Supabase (service role key — bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret between Next.js and this worker
WORKER_API_KEY=generate-a-random-string-here

# AI / search
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
XAI_API_KEY=xai-...
SERPAPI_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Optional (legacy / unused when OpenRouter is set)
# DEEPSEEK_API_KEY=sk-...
# META_LLAMA_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TAX_CODE=txcd_10000000

# DataForSEO (SEO rankings / keywords / backlinks)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional SMTP (legacy invite path — Resend on the web app is preferred)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
